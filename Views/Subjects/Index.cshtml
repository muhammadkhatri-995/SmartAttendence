@model SmartAttendance.Web.ViewModels.SubjectIndexViewModel
@{
    ViewData["Title"] = "Subjects";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Subjects</h4>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Add subject
    </a>
</div>

<form method="get" class="card card-body shadow-sm mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-6">
            <label class="form-label" for="search">Search</label>
            <input type="text" id="search" name="search" value="@Model.Search" class="form-control" placeholder="Code or name" />
        </div>
        <div class="col-md-3">
            <label class="form-label" for="status">Status</label>
            <select id="status" name="status" class="form-select">
                <option value="all" selected="@(Model.Status == "all")">All</option>
                <option value="active" selected="@(Model.Status == "active")">Active</option>
                <option value="inactive" selected="@(Model.Status == "inactive")">Inactive</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-outline-primary">Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
        </div>
    </div>
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Assignments</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Result.Items.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">No subjects found.</td>
                    </tr>
                }
                @foreach (var s in Model.Result.Items)
                {
                    <tr>
                        <td class="fw-semibold">@s.Code</td>
                        <td>@s.Name</td>
                        <td>@s.AssignmentCount</td>
                        <td>
                            @if (s.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1">
                                <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary">Edit</a>

                                @if (s.IsActive)
                                {
                                    <form asp-action="Deactivate" asp-route-id="@s.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-warning">Deactivate</button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="Activate" asp-route-id="@s.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-success">Activate</button>
                                    </form>
                                }

                                <form asp-action="Delete" asp-route-id="@s.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete this subject?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.Result.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center mb-0">
            <li class="page-item @(Model.Result.Page <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index"
                   asp-route-page="@(Model.Result.Page - 1)"
                   asp-route-search="@Model.Search"
                   asp-route-status="@Model.Status">Previous</a>
            </li>
            <li class="page-item disabled">
                <span class="page-link">Page @Model.Result.Page of @Model.Result.TotalPages</span>
            </li>
            <li class="page-item @(Model.Result.Page >= Model.Result.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index"
                   asp-route-page="@(Model.Result.Page + 1)"
                   asp-route-search="@Model.Search"
                   asp-route-status="@Model.Status">Next</a>
            </li>
        </ul>
    </nav>
}