@model SmartAttendance.Web.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Log in";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<style>
    .auth-container {
        min-height: calc(100vh - 120px);
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
        padding: 2rem 1rem;
    }

    .auth-card {
        width: 100%;
        max-width: 440px;
        border: none;
        border-radius: 1.25rem;
        background: #ffffff;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.01);
        overflow: hidden;
    }

    .auth-header {
        text-align: center;
        padding: 2.5rem 2rem 1rem;
    }

    .auth-brand-icon {
        width: 56px;
        height: 56px;
        background: rgba(13, 110, 253, 0.1);
        color: #0d6efd;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1rem;
    }

    .input-icon-wrapper {
        position: relative;
    }

    .input-icon-wrapper .input-icon {
        position: absolute;
        left: 1rem;
        top: 50%;
        transform: translateY(-50%);
        z-index: 4;
        color: #64748b;
        pointer-events: none;
        transition: color 0.2s ease;
    }

    .input-icon-wrapper .form-control {
        padding-left: 2.75rem;
        height: calc(3.5rem + 2px);
        border-radius: 0.75rem;
        border: 1px solid #cbd5e1;
    }

    .input-icon-wrapper .form-floating > label {
        padding-left: 2.75rem;
    }

    .input-icon-wrapper .form-control:focus ~ .input-icon {
        color: #0d6efd;
    }

    .btn-login {
        padding: 0.8rem 1.5rem;
        font-weight: 600;
        border-radius: 0.75rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        transition: all 0.2s ease;
    }

    .btn-login:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(13, 110, 253, 0.25);
    }

    .form-check-input {
        width: 1.15em;
        height: 1.15em;
        border-radius: 0.35em;
        cursor: pointer;
    }

    .form-check-label {
        cursor: pointer;
        user-select: none;
        color: #475569;
    }
</style>

<div class="auth-container">
    <div class="card auth-card">
        <div class="auth-header">
            <div class="auth-brand-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                    <circle cx="9" cy="7" r="4" />
                    <polyline points="16 11 18 13 22 9" />
                </svg>
            </div>
            <h1 class="h3 fw-bold text-dark mb-1">Welcome Back</h1>
            <p class="text-muted small">Sign in to your Smart Attendance account</p>
        </div>

        <div class="card-body p-4 pt-0">
            <form asp-action="Login" asp-route-returnUrl="@returnUrl" method="post" class="js-loading-form">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small" role="alert"></div>

                <div class="mb-3 input-icon-wrapper">
                    <div class="input-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect width="20" height="16" x="2" y="4" rx="2" />
                            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                        </svg>
                    </div>
                    <div class="form-floating">
                        <input asp-for="Email" class="form-control" placeholder="name@example.com" autocomplete="username" autofocus />
                        <label asp-for="Email">Email address</label>
                    </div>
                    <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="mb-3 input-icon-wrapper">
                    <div class="input-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect width="18" height="11" x="3" y="11" rx="2" ry="2" />
                            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                        </svg>
                    </div>
                    <div class="form-floating">
                        <input asp-for="Password" class="form-control" placeholder="Password" autocomplete="current-password" />
                        <label asp-for="Password">Password</label>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check m-0">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label small"></label>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary btn-login w-100">
                    <span>Sign in</span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" />
                        <polyline points="10 17 15 12 10 7" />
                        <line x1="15" x2="3" y1="12" y2="12" />
                    </svg>
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}