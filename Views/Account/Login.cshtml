@model SmartAttendance.Web.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Log in";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<style>
    /* ===== Portal design tokens (move these to site.css to reuse across the portal) ===== */
    :root {
        --sa-primary: #7c5cf0;
        --sa-primary-dark: #6342d8;
        --sa-primary-soft: #efeafe;
        --sa-bg: #f1eefc;
        --sa-card: #ffffff;
        --sa-text: #1e1b3a;
        --sa-muted: #7b7894;
        --sa-border: #e3def7;
        --sa-radius: 1.5rem;
        --sa-radius-sm: 0.9rem;
        --sa-shadow: 0 25px 50px -12px rgba(99, 66, 216, 0.25);
    }

    .auth-container {
        position: relative;
        min-height: calc(100vh - 120px);
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--sa-bg);
        padding: 2rem 1rem;
        overflow: hidden;
    }

    .auth-container::before,
    .auth-container::after {
        content: "";
        position: absolute;
        border-radius: 50%;
        background: rgba(124, 92, 240, 0.12);
        pointer-events: none;
    }
    .auth-container::before { width: 420px; height: 420px; top: -160px; right: -120px; }
    .auth-container::after  { width: 320px; height: 320px; bottom: -140px; left: -100px; }

    /* ===== Shell ===== */
    .auth-shell {
        position: relative;
        z-index: 2;
        display: flex;
        width: 100%;
        max-width: 980px;
        background: var(--sa-card);
        border-radius: 2rem;
        box-shadow: var(--sa-shadow);
        overflow: hidden;
    }

    /* ===== Left purple panel (sidebar / welcome banner look) ===== */
    .auth-side {
        position: relative;
        flex: 1 1 52%;
        padding: 2.5rem;
        color: #fff;
        background: linear-gradient(145deg, #8b6cf5 0%, #6d4ee3 60%, #5b3fd0 100%);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        overflow: hidden;
        min-height: 560px;
    }

    .auth-side .deco {
        position: absolute;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.1);
        pointer-events: none;
    }
    .auth-side .deco-1 { width: 260px; height: 260px; top: -90px; right: -80px; }
    .auth-side .deco-2 { width: 180px; height: 180px; bottom: -60px; left: -50px; }

    .auth-logo {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-weight: 700;
        font-size: 1.1rem;
        position: relative;
        z-index: 1;
    }

    .logo-badge {
        width: 44px;
        height: 44px;
        border-radius: 0.9rem;
        background: #fff;
        color: var(--sa-primary);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 8px 18px rgba(0, 0, 0, 0.15);
    }

    .side-copy {
        position: relative;
        z-index: 1;
        margin: 1.5rem 0;
    }

    .side-copy h2 {
        font-size: 2rem;
        font-weight: 800;
        line-height: 1.2;
        margin-bottom: 0.75rem;
    }

    .side-copy p {
        color: rgba(255, 255, 255, 0.8);
        margin: 0;
        max-width: 320px;
    }

    /* Floating dashboard-style mini cards */
    .mini-cards {
        position: relative;
        z-index: 1;
        display: flex;
        gap: 0.9rem;
        flex-wrap: wrap;
    }

    .mini-card {
        background: #fff;
        color: var(--sa-text);
        border-radius: var(--sa-radius-sm);
        padding: 0.9rem 1.1rem;
        min-width: 140px;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        box-shadow: 0 12px 28px rgba(30, 20, 90, 0.25);
    }

    .mini-card .mini-icon {
        width: 38px;
        height: 38px;
        border-radius: 0.7rem;
        background: var(--sa-primary-soft);
        color: var(--sa-primary);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .mini-card .mini-value { font-weight: 800; font-size: 1.05rem; line-height: 1.1; }
    .mini-card .mini-label { font-size: 0.72rem; color: var(--sa-muted); }

    /* ===== Right form panel ===== */
    .auth-form-wrap {
        flex: 1 1 48%;
        padding: 3rem 2.75rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .auth-form-wrap h1 {
        font-size: 1.75rem;
        font-weight: 800;
        color: var(--sa-text);
        margin-bottom: 0.25rem;
    }

    .auth-form-wrap .subtitle {
        color: var(--sa-muted);
        font-size: 0.92rem;
        margin-bottom: 1.75rem;
    }

    .input-icon-wrapper { position: relative; }

    .input-icon-wrapper .input-icon {
        position: absolute;
        left: 1rem;
        top: 1.1rem;
        z-index: 4;
        color: var(--sa-muted);
        pointer-events: none;
        display: flex;
        transition: color 0.2s ease;
    }

    .input-icon-wrapper:focus-within .input-icon { color: var(--sa-primary); }

    .input-icon-wrapper .form-control {
        padding-left: 2.9rem;
        height: calc(3.5rem + 2px);
        border-radius: var(--sa-radius-sm);
        border: 1.5px solid var(--sa-border);
        background: #faf9ff;
        color: var(--sa-text);
        transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    }

    .input-icon-wrapper .form-control:focus {
        background: #fff;
        border-color: var(--sa-primary);
        box-shadow: 0 0 0 0.25rem rgba(124, 92, 240, 0.15);
    }

    .input-icon-wrapper .form-floating > label {
        padding-left: 2.9rem;
        color: var(--sa-muted);
    }

    .form-check-input {
        width: 1.15em;
        height: 1.15em;
        border-radius: 0.35em;
        cursor: pointer;
        border-color: var(--sa-border);
    }

    .form-check-input:checked {
        background-color: var(--sa-primary);
        border-color: var(--sa-primary);
    }

    .form-check-input:focus {
        border-color: var(--sa-primary);
        box-shadow: 0 0 0 0.25rem rgba(124, 92, 240, 0.15);
    }

    .form-check-label {
        cursor: pointer;
        user-select: none;
        color: var(--sa-muted);
    }

    .btn-login {
        padding: 0.9rem 1.5rem;
        font-weight: 700;
        border-radius: var(--sa-radius-sm);
        border: none;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        background: linear-gradient(135deg, var(--sa-primary), var(--sa-primary-dark));
        box-shadow: 0 12px 24px rgba(124, 92, 240, 0.35);
    }

    .btn-login:hover,
    .btn-login:focus {
        color: #fff;
        background: linear-gradient(135deg, #8a6cf7, #5a3acb);
    }

    .btn-login .btn-arrow { display: inline-flex; }

    .mobile-brand { display: none; }

    @@media (max-width: 767.98px) {
        .auth-side { display: none; }
        .auth-form-wrap { padding: 2rem 1.5rem; }
        .mobile-brand {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 1.5rem;
            font-weight: 700;
            color: var(--sa-text);
        }
        .mobile-brand .logo-badge {
            background: var(--sa-primary);
            color: #fff;
        }
    }

    /* Hidden until Anime.js reveals them (noscript fallback below) */
    [data-anim] { opacity: 0; }

    @@media (prefers-reduced-motion: reduce) {
        [data-anim] { opacity: 1 !important; transform: none !important; }
    }
</style>

<noscript>
    <style>
        [data-anim] { opacity: 1 !important; }
    </style>
</noscript>

