@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.2/anime.min.js"></script>
    <script>
        (function () {
            function showAll() {
                document.querySelectorAll("[data-anim], [data-side]").forEach(function (el) {
                    el.style.opacity = 1;
                    el.style.transform = "none";
                });
                var c = document.getElementById("counterValue");
                if (c) c.textContent = "92";
            }

            var reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
            if (typeof anime === "undefined" || reduceMotion) { showAll(); return; }

            // Left-panel items start hidden through JS (so they stay visible if JS fails)
            document.querySelectorAll("[data-side]").forEach(function (el) { el.style.opacity = 0; });

            // 1. Entrance: shell, then left panel, then form content
            var tl = anime.timeline({ easing: "easeOutExpo" });

            tl.add({
                targets: "#authShell",
                opacity: [0, 1],
                translateY: [40, 0],
                scale: [0.97, 1],
                duration: 800
            })
            .add({
                targets: "[data-side]",
                opacity: [0, 1],
                translateX: [-30, 0],
                delay: anime.stagger(120),
                duration: 700
            }, "-=500")
            .add({
                targets: ".auth-form-wrap [data-anim]",
                opacity: [0, 1],
                translateY: [20, 0],
                delay: anime.stagger(90),
                duration: 600
            }, "-=800");

            // 2. Attendance counter on the stat card
            var counter = { value: 0 };
            anime({
                targets: counter,
                value: 92,
                round: 1,
                duration: 1800,
                delay: 900,
                easing: "easeOutExpo",
                update: function () {
                    document.getElementById("counterValue").textContent = counter.value;
                }
            });

            // 3. Floating mini cards (gentle bobbing loop)
            anime({
                targets: "[data-float]",
                translateY: [0, -8],
                direction: "alternate",
                loop: true,
                easing: "easeInOutSine",
                duration: 2200,
                delay: anime.stagger(400, { start: 1200 })
            });

            // 4. Decorative circles drift
            anime({
                targets: ".auth-side .deco-1",
                translateX: [0, -25], translateY: [0, 20],
                direction: "alternate", loop: true,
                easing: "easeInOutSine", duration: 5000
            });
            anime({
                targets: ".auth-side .deco-2",
                translateX: [0, 30], translateY: [0, -20],
                direction: "alternate", loop: true,
                easing: "easeInOutSine", duration: 6000
            });

            // 5. Input icon bounce on focus
            document.querySelectorAll(".input-icon-wrapper .form-control").forEach(function (input) {
                input.addEventListener("focus", function () {
                    var icon = input.closest(".input-icon-wrapper").querySelector(".input-icon");
                    anime.remove(icon);
                    anime({
                        targets: icon,
                        translateX: [0, 4, 0],
                        scale: [1, 1.2, 1],
                        duration: 450,
                        easing: "easeOutBack"
                    });
                });
            });

            // 6. Button arrow nudge + press feedback
            var btn = document.getElementById("loginBtn");
            var arrow = btn.querySelector(".btn-arrow");
            btn.addEventListener("mouseenter", function () {
                anime.remove(arrow);
                anime({ targets: arrow, translateX: 6, duration: 300, easing: "easeOutQuad" });
            });
            btn.addEventListener("mouseleave", function () {
                anime.remove(arrow);
                anime({ targets: arrow, translateX: 0, duration: 300, easing: "easeOutQuad" });
            });
            btn.addEventListener("mousedown", function () {
                anime({ targets: btn, scale: 0.97, duration: 120, easing: "easeOutQuad" });
            });
            btn.addEventListener("mouseup", function () {
                anime({ targets: btn, scale: 1, duration: 200, easing: "easeOutBack" });
            });

            // 7. Shake the shell when the server returns a login error
            if (document.querySelector(".validation-summary-errors")) {
                tl.finished.then(function () {
                    anime({
                        targets: "#authShell",
                        translateX: [0, -12, 12, -8, 8, -4, 0],
                        duration: 500,
                        easing: "easeInOutSine"
                    });
                });
            }
        })();
    </script>
}