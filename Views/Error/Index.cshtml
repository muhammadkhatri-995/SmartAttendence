@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="text-center py-5">
    <div class="display-1 fw-bold text-secondary">@Model.StatusCode</div>
    <h1 class="h3 mt-2">@Model.Title</h1>
    <p class="text-muted mx-auto error-message">@Model.Message</p>
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">
        <i class="bi bi-house me-1" aria-hidden="true"></i>Go to home
    </a>
    @if (!string.IsNullOrEmpty(Model.RequestId) && Model.StatusCode >= 500)
    {
        <p class="text-muted small mt-4">Request ID: <code>@Model.RequestId</code></p>
    }
</div>