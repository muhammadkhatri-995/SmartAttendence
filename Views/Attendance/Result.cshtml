@model SmartAttendance.Web.ViewModels.AttendanceResultViewModel
@{
    ViewData["Title"] = "Attendance saved";

    // wa.me needs digits only, so drop a "+" if the number was stored with one.
    var waUrl = (Model.WhatsAppUrl ?? string.Empty).Replace("wa.me/+", "wa.me/");
    var hasUrl = !string.IsNullOrWhiteSpace(waUrl);
    var absent = Model.Total - Model.Present;
    var rate = Model.Total > 0 ? (int)Math.Round(Model.Present * 100.0 / Model.Total) : 0;
    var waKey = "wa-opened-" + Model.AssignmentId + "-" + Model.Date.ToString("yyyyMMdd");
}

<style>
    /* Colours come from the layout tokens. The fallbacks only apply if a token is missing. */

    /* ===== Success banner ===== */
    .res-banner {
        position: relative;
        overflow: hidden;
        border-radius: var(--sa-radius, 1.5rem);
        padding: 1.75rem 2rem;
        color: #fff;
        background: linear-gradient(145deg, #8b6cf5 0%, #6d4ee3 60%, #5b3fd0 100%);
        box-shadow: var(--sa-shadow, 0 20px 40px -15px rgba(99, 66, 216, 0.22));
        margin-bottom: 1.25rem;
        display: flex;
        align-items: center;
        gap: 1.1rem;
    }

    .res-banner .deco {
        position: absolute;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.1);
        pointer-events: none;
    }
    .res-banner .deco-1 { width: 240px; height: 240px; top: -90px; right: -60px; }
    .res-banner .deco-2 { width: 150px; height: 150px; bottom: -70px; right: 180px; }

    .res-check {
        position: relative;
        z-index: 1;
        width: 64px;
        height: 64px;
        flex-shrink: 0;
        border-radius: 1.2rem;
        background: #fff;
        color: var(--sa-success, #16a34a);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        box-shadow: 0 10px 24px rgba(30, 20, 90, 0.3);
    }

    .res-banner-main { position: relative; z-index: 1; min-width: 0; }

    .res-banner h1 {
        font-size: 1.6rem;
        font-weight: 800;
        margin: 0 0 0.6rem;
        color: #fff;
    }

    .meta-chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }

    .meta-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: rgba(255, 255, 255, 0.18);
        border: 1px solid rgba(255, 255, 255, 0.25);
        color: #fff;
        border-radius: 999px;
        padding: 0.3rem 0.85rem;
        font-size: 0.85rem;
        font-weight: 500;
        max-width: 100%;
    }

    /* ===== Stat cards ===== */
    .stat-col { min-width: 0; }

    .stat-card {
        background: var(--sa-card, #ffffff);
        border-radius: var(--sa-radius-sm, 0.9rem);
        padding: 1rem 1.15rem;
        display: flex;
        align-items: center;
        gap: 0.9rem;
        box-shadow: 0 8px 22px rgba(99, 66, 216, 0.08);
        border: 1px solid var(--sa-border, #e3def7);
        height: 100%;
        min-width: 0;
    }

    .stat-icon {
        width: 44px;
        height: 44px;
        border-radius: 0.85rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .stat-icon.total   { background: var(--sa-primary-soft, #efeafe); color: var(--sa-primary, #7c5cf0); }
    .stat-icon.present { background: var(--sa-success-soft, #e8f8ef); color: var(--sa-success, #16a34a); }
    .stat-icon.absent  { background: var(--sa-danger-soft, #fdecee);  color: var(--sa-danger, #e5484d); }

    .stat-value { font-size: 1.5rem; font-weight: 800; line-height: 1.1; color: var(--sa-text, #1e1b3a); }
    .stat-label { font-size: 0.78rem; color: var(--sa-muted, #7b7894); }

    /* ===== White cards ===== */
    .res-card {
        background: var(--sa-card, #ffffff);
        border: 1px solid var(--sa-border, #e3def7);
        border-radius: var(--sa-radius, 1.5rem);
        padding: 1.25rem;
        box-shadow: 0 8px 22px rgba(99, 66, 216, 0.08);
        margin-bottom: 1rem;
    }

    .res-card h2 {
        font-size: 1.05rem;
        font-weight: 700;
        margin: 0 0 0.9rem;
        color: var(--sa-text, #1e1b3a);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .res-card h2 i { color: var(--sa-primary, #7c5cf0); }

    /* ===== Progress ===== */
    .progress-top {
        display: flex;
        justify-content: space-between;
        font-size: 0.82rem;
        color: var(--sa-muted, #7b7894);
        margin-bottom: 0.5rem;
    }
    .progress-top strong { color: var(--sa-text, #1e1b3a); }

    .progress-track {
        height: 10px;
        border-radius: 999px;
        background: var(--sa-danger-soft, #fdecee);
        overflow: hidden;
    }

    .progress-fill {
        height: 100%;
        border-radius: 999px;
        background: linear-gradient(90deg, #34c47a, #16a34a);
    }

    /* ===== Absent rolls ===== */
    .res-label { font-size: 0.78rem; color: var(--sa-muted, #7b7894); margin-bottom: 0.5rem; font-weight: 600; }

    .roll-chip {
        display: inline-flex;
        align-items: center;
        border-radius: 0.75rem;
        padding: 0.35rem 0.8rem;
        font-weight: 700;
        font-size: 0.9rem;
        background: var(--sa-danger-soft, #fdecee);
        color: var(--sa-danger-dark, #cf3a40);
        border: 1px solid rgba(229, 72, 77, 0.25);
    }

    .all-present {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        background: var(--sa-success-soft, #e8f8ef);
        color: var(--sa-success, #16a34a);
        border-radius: var(--sa-radius-sm, 0.9rem);
        padding: 0.7rem 1rem;
        font-weight: 600;
    }

    /* ===== Message ===== */
    .msg-box {
        width: 100%;
        resize: vertical;
        min-height: 150px;
        border: 1.5px solid var(--sa-border, #e3def7);
        background: var(--sa-input-bg, #faf9ff);
        color: var(--sa-text, #1e1b3a);
        border-radius: var(--sa-radius-sm, 0.9rem);
        padding: 0.9rem 1rem;
        font-size: 0.95rem;
        line-height: 1.5;
        margin-bottom: 1rem;
    }
    .msg-box:focus {
        outline: none;
        border-color: var(--sa-primary, #7c5cf0);
        box-shadow: 0 0 0 0.25rem rgba(124, 92, 240, 0.15);
    }

    .res-actions { display: flex; flex-wrap: wrap; gap: 0.6rem; }

    .btn-copy,
    .btn-wa,
    .btn-ghost {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        font-weight: 700;
        border-radius: var(--sa-radius-sm, 0.9rem);
        padding: 0.75rem 1.4rem;
        text-decoration: none;
        cursor: pointer;
        transition: transform 0.15s ease, filter 0.2s ease;
    }

    .btn-copy {
        border: 1.5px solid var(--sa-primary, #7c5cf0);
        background: var(--sa-primary-soft, #efeafe);
        color: var(--sa-primary-dark, #6342d8);
    }
    .btn-copy:hover { filter: brightness(0.96); transform: translateY(-1px); color: var(--sa-primary-dark, #6342d8); }

    .btn-wa {
        border: none;
        color: #fff;
        background: linear-gradient(135deg, #2fd16c, #16a34a);
        box-shadow: 0 10px 22px rgba(22, 163, 74, 0.3);
    }
    .btn-wa:hover { color: #fff; filter: brightness(1.05); transform: translateY(-1px); }

    .btn-ghost {
        border: 1px solid var(--sa-border, #e3def7);
        background: var(--sa-card, #ffffff);
        color: var(--sa-text, #1e1b3a);
    }
    .btn-ghost:hover { background: var(--sa-primary-soft, #efeafe); color: var(--sa-primary-dark, #6342d8); transform: translateY(-1px); }

    .warn-box {
        display: flex;
        align-items: flex-start;
        gap: 0.6rem;
        margin-top: 1rem;
        background: var(--sa-warning-soft, #fff4e0);
        color: var(--sa-warning, #e08a00);
        border-radius: var(--sa-radius-sm, 0.9rem);
        padding: 0.8rem 1rem;
        font-size: 0.9rem;
        font-weight: 500;
    }
    .warn-box i { margin-top: 0.1rem; }

    /* ===== Toast ===== */
    .sa-toast {
        background: linear-gradient(135deg, #7c5cf0, #6342d8);
        color: #fff;
        border-radius: var(--sa-radius-sm, 0.9rem);
        padding: 0.7rem 1.1rem;
        margin-bottom: 0.5rem;
        font-weight: 600;
        font-size: 0.9rem;
        box-shadow: 0 14px 30px rgba(99, 66, 216, 0.4);
        transition: opacity 0.4s ease;
    }

    /* ===== Phones ===== */
    @@media (max-width: 575.98px) {
        .res-banner { padding: 1.25rem 1.1rem; gap: 0.85rem; }
        .res-check { width: 52px; height: 52px; font-size: 1.6rem; border-radius: 1rem; }
        .res-banner h1 { font-size: 1.3rem; }
        .meta-chip { font-size: 0.8rem; padding: 0.25rem 0.7rem; }

        /* Stat cards: icon on top so three fit in a row */
        .stat-card {
            flex-direction: column;
            justify-content: center;
            text-align: center;
            gap: 0.45rem;
            padding: 0.8rem 0.35rem;
        }
        .stat-icon { width: 36px; height: 36px; border-radius: 0.7rem; }
        .stat-value { font-size: 1.3rem; }
        .stat-label { font-size: 0.72rem; }

        .res-card { padding: 1rem; }
        .btn-copy, .btn-wa { width: 100%; }
        .nav-actions .btn-ghost { flex: 1; padding: 0.75rem 0.5rem; }
    }
</style>

<div id="toastBox" class="position-fixed top-0 end-0 p-3" style="z-index: 2000;"></div>

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">

        <!-- Success banner -->
        <div class="res-banner res-anim">
            <span class="deco deco-1"></span>
            <span class="deco deco-2"></span>
            <div class="res-check" id="resCheck"><i class="bi bi-check-lg" aria-hidden="true"></i></div>
            <div class="res-banner-main">
                <h1>Attendance saved</h1>
                <div class="meta-chips">
                    <span class="meta-chip"><i class="bi bi-people" aria-hidden="true"></i>@Model.ClassLabel</span>
                    <span class="meta-chip"><i class="bi bi-calendar3" aria-hidden="true"></i>@Model.Date.ToString("dddd, dd MMMM yyyy")</span>
                    <span class="meta-chip"><i class="bi bi-journal-bookmark" aria-hidden="true"></i>@Model.Subject</span>
                    <span class="meta-chip"><i class="bi bi-person-badge" aria-hidden="true"></i>@Model.Teacher</span>
                </div>
            </div>
        </div>

        <!-- Stat cards -->
        <div class="row g-2 g-md-3 mb-3">
            <div class="col-4 stat-col res-anim">
                <div class="stat-card">
                    <span class="stat-icon total"><i class="bi bi-people-fill" aria-hidden="true"></i></span>
                    <div>
                        <div class="stat-value" data-count="@Model.Total">@Model.Total</div>
                        <div class="stat-label">Total</div>
                    </div>
                </div>
            </div>
            <div class="col-4 stat-col res-anim">
                <div class="stat-card">
                    <span class="stat-icon present"><i class="bi bi-check-circle-fill" aria-hidden="true"></i></span>
                    <div>
                        <div class="stat-value" data-count="@Model.Present">@Model.Present</div>
                        <div class="stat-label">Present</div>
                    </div>
                </div>
            </div>
            <div class="col-4 stat-col res-anim">
                <div class="stat-card">
                    <span class="stat-icon absent"><i class="bi bi-x-circle-fill" aria-hidden="true"></i></span>
                    <div>
                        <div class="stat-value" data-count="@absent">@absent</div>
                        <div class="stat-label">Absent</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Rate + absent rolls -->
        <div class="res-card res-anim">
            <div class="progress-top">
                <span>Attendance rate</span>
                <strong><span id="rateValue" data-count="@rate">@rate</span>%</strong>
            </div>
            <div class="progress-track mb-4">
                <div class="progress-fill" id="progressFill" data-rate="@rate" style="width: @(rate)%;"></div>
            </div>

            @if (Model.AbsentRolls.Count > 0)
            {
                <div class="res-label">Absent roll numbers</div>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var roll in Model.AbsentRolls)
                    {
                        <span class="roll-chip">@roll</span>
                    }
                </div>
            }
            else
            {
                <div class="all-present">
                    <i class="bi bi-emoji-smile-fill" aria-hidden="true"></i>Everyone was present.
                </div>
            }
        </div>

        <!-- Message -->
        <div class="res-card res-anim">
            <h2><i class="bi bi-chat-text-fill" aria-hidden="true"></i>Message for @Model.Teacher</h2>
            <textarea id="msg" class="msg-box" rows="6" readonly>@Model.Message</textarea>

            <div class="res-actions">
                <button type="button" id="copyBtn" class="btn-copy">
                    <i class="bi bi-clipboard" aria-hidden="true"></i>Copy message
                </button>

                @if (hasUrl)
                {
                    <a id="openWa" href="@waUrl" target="_blank" rel="noopener" class="btn-wa">
                        <i class="bi bi-whatsapp" aria-hidden="true"></i>Open WhatsApp
                    </a>
                }
            </div>

            @if (!hasUrl)
            {
                <div class="warn-box alert alert-warning mb-0" data-keep="true" role="alert">
                    <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                    <span>This teacher has no valid WhatsApp number. Add it under Teachers, then open this page again.</span>
                </div>
            }
        </div>

        <div class="res-actions nav-actions res-anim">
            <a asp-controller="Attendance" asp-action="Index" asp-route-date="@Model.Date.ToString("yyyy-MM-dd")"
               class="btn-ghost"><i class="bi bi-arrow-left" aria-hidden="true"></i>Back to lectures</a>
            <a asp-controller="Attendance" asp-action="History" class="btn-ghost">
                <i class="bi bi-clock-history" aria-hidden="true"></i>History
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.2/anime.min.js"></script>
    <script>
        (function () {
            var HIDE_AFTER_MS = 2000;
            var WA_URL = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(hasUrl ? waUrl : ""));
            var WA_KEY = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(waKey));
            var box = document.getElementById('toastBox');

            // Small notification that removes itself after 2 seconds.
            function showToast(text) {
                if (!box) return;
                var t = document.createElement('div');
                t.className = 'sa-toast';
                t.textContent = text;
                box.appendChild(t);
                setTimeout(function () {
                    t.style.opacity = '0';
                    setTimeout(function () { t.remove(); }, 400);
                }, HIDE_AFTER_MS);
            }

            // Hide the layout's alerts (for example "Attendance saved") after 2 seconds.
            setTimeout(function () {
                document.querySelectorAll('.alert:not([data-keep])').forEach(function (a) {
                    a.style.transition = 'opacity .4s';
                    a.style.opacity = '0';
                    setTimeout(function () { a.remove(); }, 400);
                });
            }, HIDE_AFTER_MS);

            // Copy the message.
            var msg = document.getElementById('msg');
            var copyBtn = document.getElementById('copyBtn');

            function copyText(text) {
                if (navigator.clipboard && window.isSecureContext) {
                    return navigator.clipboard.writeText(text);
                }
                return new Promise(function (resolve, reject) {
                    try {
                        msg.removeAttribute('readonly');
                        msg.select();
                        var ok = document.execCommand('copy');
                        msg.setAttribute('readonly', '');
                        msg.setSelectionRange(0, 0);
                        ok ? resolve() : reject(new Error('copy failed'));
                    } catch (e) {
                        reject(e);
                    }
                });
            }

            if (copyBtn && msg) {
                copyBtn.addEventListener('click', function () {
                    copyText(msg.value)
                        .then(function () { showToast('Message copied'); })
                        .catch(function () { showToast('Could not copy. Select the text and press Ctrl+C.'); });
                });
            }

            // Open WhatsApp once per saved attendance, so pressing Back does not reopen it.
            if (WA_URL) {
                var alreadyOpened = false;
                try { alreadyOpened = sessionStorage.getItem(WA_KEY) === '1'; } catch (e) { }

                if (!alreadyOpened) {
                    showToast('Opening WhatsApp...');
                    setTimeout(function () {
                        try { sessionStorage.setItem(WA_KEY, '1'); } catch (e) { }
                        window.location.href = WA_URL;
                    }, HIDE_AFTER_MS);
                }
            }

            // ===== Entrance animation (purely cosmetic, page is fully visible without it) =====
            function restoreAll() {
                document.querySelectorAll('.res-anim, .roll-chip, #resCheck').forEach(function (el) {
                    el.style.opacity = '';
                    el.style.transform = '';
                });
                document.querySelectorAll('[data-count]').forEach(function (el) {
                    el.textContent = el.getAttribute('data-count');
                });
                var fill = document.getElementById('progressFill');
                if (fill) fill.style.width = (fill.getAttribute('data-rate') || 0) + '%';
            }

            try {
                var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                if (typeof anime === 'undefined' || reduce) { return; }

                var fill = document.getElementById('progressFill');
                var rateTarget = fill ? parseInt(fill.getAttribute('data-rate'), 10) || 0 : 0;

                // Start state (set here, so nothing is ever hidden if this script does not run)
                document.querySelectorAll('.res-anim').forEach(function (el) { el.style.opacity = '0'; });
                document.querySelectorAll('[data-count]').forEach(function (el) { el.textContent = '0'; });
                if (fill) fill.style.width = '0%';

                var tl = anime.timeline({ easing: 'easeOutExpo' });

                tl.add({
                    targets: '.res-banner',
                    opacity: [0, 1], translateY: [-24, 0], duration: 700
                })
                .add({
                    targets: '#resCheck',
                    scale: [0, 1], rotate: ['-90deg', '0deg'],
                    duration: 900, easing: 'easeOutElastic(1, .6)'
                }, '-=450')
                .add({
                    targets: '.stat-col',
                    opacity: [0, 1], translateY: [24, 0],
                    delay: anime.stagger(100), duration: 600
                }, '-=600')
                .add({
                    targets: '.res-card, .nav-actions',
                    opacity: [0, 1], translateY: [20, 0],
                    delay: anime.stagger(100), duration: 600
                }, '-=400');

                // Count-up for the numbers
                document.querySelectorAll('[data-count]').forEach(function (el) {
                    var target = parseInt(el.getAttribute('data-count'), 10) || 0;
                    var obj = { v: 0 };
                    anime({
                        targets: obj, v: target, round: 1,
                        duration: 1100, delay: 500, easing: 'easeOutExpo',
                        update: function () { el.textContent = obj.v; },
                        complete: function () { el.textContent = target; }
                    });
                });

                // Attendance rate bar
                if (fill) {
                    anime({
                        targets: fill, width: rateTarget + '%',
                        duration: 1200, delay: 700, easing: 'easeOutQuad'
                    });
                }

                // Absent roll chips pop in
                anime({
                    targets: '.roll-chip',
                    opacity: [0, 1], scale: [0.7, 1],
                    delay: anime.stagger(40, { start: 900 }),
                    duration: 450, easing: 'easeOutBack'
                });

                // Whatever happens, finish fully visible
                tl.finished.then(restoreAll);
                setTimeout(restoreAll, 3500);

                // Press feedback on the buttons
                document.querySelectorAll('.btn-copy, .btn-wa, .btn-ghost').forEach(function (btn) {
                    btn.addEventListener('mousedown', function () {
                        anime({ targets: btn, scale: 0.96, duration: 120, easing: 'easeOutQuad' });
                    });
                    ['mouseup', 'mouseleave'].forEach(function (evt) {
                        btn.addEventListener(evt, function () {
                            anime({ targets: btn, scale: 1, duration: 220, easing: 'easeOutBack' });
                        });
                    });
                });
            } catch (err) {
                restoreAll();
            }
        })();
    </script>
}