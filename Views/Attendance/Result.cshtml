        <text>
                    // Open WhatsApp once per saved attendance, so pressing Back does not reopen it.
                    var url = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(waUrl));
                    var key = "wa-opened-@Model.AssignmentId-@Model.Date.ToString("yyyyMMdd")";

                    var alreadyOpened = false;
                    try { alreadyOpened = sessionStorage.getItem(key) === '1'; } catch (e) { }

                    if (!alreadyOpened) {
                        showToast('Opening WhatsApp...');
