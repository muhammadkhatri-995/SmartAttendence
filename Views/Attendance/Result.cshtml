<script>
        (function () {
            var HIDE_AFTER_MS = 2000;
            var box = document.getElementById('toastBox');

            // Small notification that removes itself after 2 seconds.
            function showToast(text) {
                if (!box) return;
                var t = document.createElement('div');
                t.className = 'bg-dark text-white rounded shadow px-3 py-2 mb-2';
                t.style.transition = 'opacity .4s';
                t.textContent = text;
                box.appendChild(t);
                setTimeout(function () {
                    t.style.opacity = '0';
                    setTimeout(function () { t.remove(); }, 400);
                }, HIDE_AFTER_MS);
            }

            // Hide the layout's alerts (for example "Attendance saved") after 2 seconds.
            setTimeout(function () {
                document.querySelectorAll('.alert:not([data-keep])').forEach(function (a) {
                    a.style.transition = 'opacity .4s';
                    a.style.opacity = '0';
                    setTimeout(function () { a.remove(); }, 400);
                });
            }, HIDE_AFTER_MS);

            // Copy the message.
            var msg = document.getElementById('msg');
            var copyBtn = document.getElementById('copyBtn');

            function copyText(text) {
                if (navigator.clipboard && window.isSecureContext) {
                    return navigator.clipboard.writeText(text);
                }
                return new Promise(function (resolve, reject) {
                    try {
                        msg.removeAttribute('readonly');
                        msg.select();
                        var ok = document.execCommand('copy');
                        msg.setAttribute('readonly', '');
                        msg.setSelectionRange(0, 0);
