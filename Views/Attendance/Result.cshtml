                    } catch (e) {
                        reject(e);
                    }
                });
            }

            if (copyBtn && msg) {
                copyBtn.addEventListener('click', function () {
                    copyText(msg.value)
                        .then(function () { showToast('Message copied'); })
                        .catch(function () { showToast('Could not copy. Select the text and press Ctrl+C.'); });
                });
            }

    @if (hasUrl)
