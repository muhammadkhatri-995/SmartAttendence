@model AttendanceIndexViewModel
@{
    ViewData["Title"] = "Take attendance";
    var isToday = Model.Date == Model.Today;
}

<div class="page-header d-flex flex-wrap justify-content-between align-items-end gap-2">
    <div>
        <h1 class="h3 mb-1">@(isToday ? "Today's lectures" : "Lectures")</h1>
        <p class="text-muted mb-0">@Model.Date.ToString("dddd, dd MMMM yyyy") &middot; @Model.Class.ClassName - @Model.Class.Section</p>
    </div>
    <form method="get" class="d-flex gap-2 align-items-end">
        <div>
            <label for="date" class="form-label mb-1 small">Other date</label>
            <input id="date" name="date" type="date" class="form-control form-control-sm"
                   value="@Model.Date.ToString("yyyy-MM-dd")" max="@Model.Today.ToString("yyyy-MM-dd")" />
        </div>
        <button type="submit" class="btn btn-sm btn-outline-primary">Go</button>
    </form>
</div>

@if (Model.Slots.Count == 0)
{
    <div class="card">
        <div class="card-body text-center text-muted py-5">
            <i class="bi bi-calendar-x display-4" aria-hidden="true"></i>
            <p class="mt-3 mb-0">
                No lectures in the timetable for @Model.Date.DayOfWeek.
                <a asp-controller="Timetable" asp-action="Index">Edit timetable</a>
            </p>
        </div>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var s in Model.Slots)
        {
            <div class="col-md-6 col-xl-4">
                <div class="card h-100">
                    <div class="card-body d-flex flex-column">
                        <div class="text-muted small">@s.Start.ToString("hh:mm tt")</div>
                        <h2 class="h5">@s.Subject</h2>
                        <div class="text-muted mb-3">@s.Teacher</div>
                        <div class="mt-auto d-flex gap-2 align-items-center">
                            @if (s.SessionId is not null)
                            {
                                <span class="badge text-bg-success">Done</span>
                                <a class="btn btn-sm btn-outline-success ms-auto" asp-action="Result" asp-route-id="@s.SessionId">Report</a>
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Mark"
                                   asp-route-assignmentId="@s.AssignmentId" asp-route-date="@Model.Date.ToString("yyyy-MM-dd")">Edit</a>
                            }
                            else
                            {
                                <a class="btn btn-primary w-100" asp-action="Mark"
                                   asp-route-assignmentId="@s.AssignmentId" asp-route-date="@Model.Date.ToString("yyyy-MM-dd")">
                                    <i class="bi bi-check2-square me-1" aria-hidden="true"></i>Take attendance
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}