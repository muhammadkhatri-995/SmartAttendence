@* @model PagedResult<HistoryRow>
@{
    ViewData["Title"] = "History";
}

<div class="page-header"><h1 class="h3 mb-1">Attendance history</h1></div>

<div class="card">
    @if (Model.TotalCount == 0)
    {
        <div class="card-body text-center text-muted py-5">No attendance taken yet.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr><th>Date</th><th>Subject</th><th>Teacher</th><th>Present</th><th>Absent</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Items)
                    {
                        <tr>
                            <td>@r.Date.ToString("dd MMM yyyy")</td>
                            <td>@r.Subject</td>
                            <td>@r.Teacher</td>
                            <td class="text-success fw-semibold">@r.Present</td>
                            <td class="text-danger fw-semibold">@r.Absent</td>
                            <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Result" asp-route-id="@r.Id">Open</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<partial name="_Pagination" model="Model.ToPagination(new Dictionary<string, string>())" /> *@

                            @model PagedResult<HistoryRow>
@{
    ViewData["Title"] = "History";
}

<style>
    /* Colours come from the layout tokens. The fallbacks only apply if a token is missing. */

    /* ===== Header banner ===== */
    .his-banner {
        position: relative;
        overflow: hidden;
        border-radius: var(--sa-radius, 1.5rem);
        padding: 1.75rem 2rem;
        color: #fff;
        background: linear-gradient(145deg, #8b6cf5 0%, #6d4ee3 60%, #5b3fd0 100%);
        box-shadow: var(--sa-shadow, 0 20px 40px -15px rgba(99, 66, 216, 0.22));
        margin-bottom: 1.25rem;
    }

    .his-banner .deco {
        position: absolute;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.1);
        pointer-events: none;
    }
    .his-banner .deco-1 { width: 240px; height: 240px; top: -90px; right: -60px; }
    .his-banner .deco-2 { width: 150px; height: 150px; bottom: -70px; right: 180px; }

    .his-banner h1 {
        position: relative;
        z-index: 1;
        font-size: 1.7rem;
        font-weight: 800;
        margin: 0 0 0.75rem;
        color: #fff;
    }

    .meta-chips { position: relative; z-index: 1; display: flex; flex-wrap: wrap; gap: 0.5rem; }

    .meta-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: rgba(255, 255, 255, 0.18);
        border: 1px solid rgba(255, 255, 255, 0.25);
        color: #fff;
        border-radius: 999px;
        padding: 0.3rem 0.85rem;
        font-size: 0.85rem;
        font-weight: 500;
    }

    /* ===== Table card ===== */
    .his-card {
        background: var(--sa-card, #ffffff);
        border: 1px solid var(--sa-border, #e3def7);
        border-radius: var(--sa-radius, 1.5rem);
        box-shadow: 0 8px 22px rgba(99, 66, 216, 0.08);
        overflow: hidden;
        margin-bottom: 1rem;
    }

    .his-table {
        width: 100%;
        margin: 0;
        border-collapse: separate;
        border-spacing: 0;
    }

    .his-table thead th {
        background: var(--sa-primary-soft, #efeafe);
        color: var(--sa-primary-dark, #6342d8);
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        padding: 0.9rem 1rem;
        border: none;
        white-space: nowrap;
    }

    .his-table tbody td {
        padding: 0.9rem 1rem;
        border-top: 1px solid var(--sa-border, #e3def7);
        color: var(--sa-text, #1e1b3a);
        vertical-align: middle;
    }

    .his-table tbody tr { transition: background 0.2s ease; }
    .his-table tbody tr:hover { background: var(--sa-primary-soft, #efeafe); }

    .date-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: var(--sa-primary-soft, #efeafe);
        color: var(--sa-primary-dark, #6342d8);
        border-radius: 999px;
        padding: 0.25rem 0.75rem;
        font-size: 0.82rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .subject-name { font-weight: 700; }

    .teacher-cell {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--sa-muted, #7b7894);
        font-size: 0.92rem;
    }

    .teacher-cell .avatar {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: var(--sa-primary-soft, #efeafe);
        color: var(--sa-primary, #7c5cf0);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.8rem;
        flex-shrink: 0;
    }

    .pill {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        border-radius: 999px;
        padding: 0.2rem 0.75rem;
        font-size: 0.85rem;
        font-weight: 800;
        min-width: 2.4rem;
        justify-content: center;
    }
    .pill.present { background: var(--sa-success-soft, #e8f8ef); color: var(--sa-success, #16a34a); }
    .pill.absent  { background: var(--sa-danger-soft, #fdecee);  color: var(--sa-danger, #e5484d); }

    .rate-wrap { min-width: 110px; }
    .rate-num { font-size: 0.8rem; font-weight: 700; color: var(--sa-text, #1e1b3a); margin-bottom: 0.25rem; }
    .rate-track {
        height: 7px;
        border-radius: 999px;
        background: var(--sa-danger-soft, #fdecee);
        overflow: hidden;
    }
    .rate-fill {
        height: 100%;
        border-radius: 999px;
        background: linear-gradient(90deg, #34c47a, #16a34a);
    }

    .btn-open {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        border: none;
        color: #fff;
        font-weight: 700;
        font-size: 0.85rem;
        border-radius: 0.8rem;
        padding: 0.5rem 1rem;
        background: linear-gradient(135deg, #7c5cf0, #6342d8);
        box-shadow: 0 8px 18px rgba(124, 92, 240, 0.28);
        text-decoration: none;
        transition: transform 0.15s ease;
    }
    .btn-open:hover,
    .btn-open:focus { color: #fff; background: linear-gradient(135deg, #8a6cf7, #5a3acb); transform: translateY(-1px); }

    /* ===== Mobile cards (shown on phones only) ===== */
    .his-list { display: none; padding: 0.75rem; }

    .his-item {
        position: relative;
        background: var(--sa-card, #ffffff);
        border: 1px solid var(--sa-border, #e3def7);
        border-radius: var(--sa-radius-sm, 0.9rem);
        padding: 0.95rem 0.95rem 0.95rem 1.2rem;
        margin-bottom: 0.7rem;
        overflow: hidden;
    }
    .his-item:last-child { margin-bottom: 0; }

    .his-item::before {
        content: "";
        position: absolute;
        left: 0; top: 0; bottom: 0;
        width: 5px;
        background: linear-gradient(180deg, #8b6cf5, #6342d8);
    }

    .his-item-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.6rem;
    }

    .his-item .subject-name { font-size: 1.05rem; margin-bottom: 0.2rem; overflow-wrap: anywhere; color: var(--sa-text, #1e1b3a); }

    .his-item-stats {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin: 0.7rem 0;
    }

    .his-item-stats .rate-wrap { flex: 1; min-width: 0; margin-left: 0.3rem; }
    .his-item .btn-open { width: 100%; padding: 0.65rem 1rem; }

    /* ===== Empty state ===== */
    .empty-card {
        padding: 3rem 1.5rem;
        text-align: center;
        color: var(--sa-text, #1e1b3a);
    }
    .empty-card .empty-icon {
        width: 72px; height: 72px;
        margin: 0 auto 1rem;
        border-radius: 1.2rem;
        background: var(--sa-primary-soft, #efeafe);
        color: var(--sa-primary, #7c5cf0);
        display: flex; align-items: center; justify-content: center;
        font-size: 2rem;
    }

    /* ===== Pagination (works with the Bootstrap markup of _Pagination) ===== */
    .pagination {
        --bs-pagination-color: var(--sa-primary-dark, #6342d8);
        --bs-pagination-bg: var(--sa-card, #ffffff);
        --bs-pagination-border-color: var(--sa-border, #e3def7);
        --bs-pagination-hover-color: var(--sa-primary-dark, #6342d8);
        --bs-pagination-hover-bg: var(--sa-primary-soft, #efeafe);
        --bs-pagination-hover-border-color: var(--sa-border, #e3def7);
        --bs-pagination-focus-color: var(--sa-primary-dark, #6342d8);
        --bs-pagination-focus-bg: var(--sa-primary-soft, #efeafe);
        --bs-pagination-focus-box-shadow: 0 0 0 0.25rem rgba(124, 92, 240, 0.2);
        --bs-pagination-active-color: #fff;
        --bs-pagination-active-bg: #7c5cf0;
        --bs-pagination-active-border-color: #7c5cf0;
        --bs-pagination-disabled-color: var(--sa-muted, #7b7894);
        --bs-pagination-disabled-bg: var(--sa-input-bg, #faf9ff);
        --bs-pagination-disabled-border-color: var(--sa-border, #e3def7);
        --bs-pagination-border-radius: 0.75rem;
        gap: 0.25rem;
        flex-wrap: wrap;
        justify-content: center;
    }
    .pagination .page-link { border-radius: 0.75rem; font-weight: 600; }

    /* ===== Phones ===== */
    @@media (max-width: 767.98px) {
        .his-banner { padding: 1.25rem 1.1rem; }
        .his-banner h1 { font-size: 1.4rem; }
        .meta-chip { font-size: 0.8rem; padding: 0.25rem 0.7rem; }

        .his-table-wrap { display: none; }
        .his-list { display: block; }
    }
</style>

<div class="his-banner his-anim">
    <span class="deco deco-1"></span>
    <span class="deco deco-2"></span>
    <h1>Attendance history</h1>
    <div class="meta-chips">
        <span class="meta-chip">
            <i class="bi bi-clock-history" aria-hidden="true"></i>@Model.TotalCount record@(Model.TotalCount == 1 ? "" : "s")
        </span>
    </div>
</div>

<div class="his-card his-anim">
    @if (Model.TotalCount == 0)
    {
        <div class="empty-card">
            <div class="empty-icon"><i class="bi bi-calendar-x" aria-hidden="true"></i></div>
            <h2 class="h5 fw-bold mb-1">No attendance taken yet</h2>
            <p class="mb-0" style="color: var(--sa-muted, #7b7894);">Saved attendance will show up here.</p>
        </div>
    }
    else
    {
        <!-- Desktop / tablet: table -->
        <div class="table-responsive his-table-wrap">
            <table class="table his-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Subject</th>
                        <th>Teacher</th>
                        <th>Present</th>
                        <th>Absent</th>
                        <th>Rate</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Items)
                    {
                        var total = r.Present + r.Absent;
                        var rate = total > 0 ? (int)Math.Round(r.Present * 100.0 / total) : 0;
                        <tr>
                            <td><span class="date-chip"><i class="bi bi-calendar3" aria-hidden="true"></i>@r.Date.ToString("dd MMM yyyy")</span></td>
                            <td class="subject-name">@r.Subject</td>
                            <td>
                                <div class="teacher-cell">
                                    <span class="avatar"><i class="bi bi-person-fill" aria-hidden="true"></i></span>
                                    <span>@r.Teacher</span>
                                </div>
                            </td>
                            <td><span class="pill present">@r.Present</span></td>
                            <td><span class="pill absent">@r.Absent</span></td>
                            <td>
                                <div class="rate-wrap">
                                    <div class="rate-num">@rate%</div>
                                    <div class="rate-track"><div class="rate-fill" style="width: @(rate)%;"></div></div>
                                </div>
                            </td>
                            <td class="text-end">
                                <a class="btn-open" asp-action="Result" asp-route-id="@r.Id">
                                    Open<i class="bi bi-arrow-right" aria-hidden="true"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Phones: one card per record -->
        <div class="his-list">
            @foreach (var r in Model.Items)
            {
                var total = r.Present + r.Absent;
                var rate = total > 0 ? (int)Math.Round(r.Present * 100.0 / total) : 0;
                <div class="his-item">
                    <div class="his-item-top">
                        <span class="date-chip"><i class="bi bi-calendar3" aria-hidden="true"></i>@r.Date.ToString("dd MMM yyyy")</span>
                    </div>
                    <div class="subject-name">@r.Subject</div>
                    <div class="teacher-cell">
                        <span class="avatar"><i class="bi bi-person-fill" aria-hidden="true"></i></span>
                        <span>@r.Teacher</span>
                    </div>
                    <div class="his-item-stats">
                        <span class="pill present"><i class="bi bi-check2" aria-hidden="true"></i>@r.Present</span>
                        <span class="pill absent"><i class="bi bi-x-lg" aria-hidden="true"></i>@r.Absent</span>
                        <div class="rate-wrap">
                            <div class="rate-num">@rate%</div>
                            <div class="rate-track"><div class="rate-fill" style="width: @(rate)%;"></div></div>
                        </div>
                    </div>
                    <a class="btn-open" asp-action="Result" asp-route-id="@r.Id">
                        Open<i class="bi bi-arrow-right" aria-hidden="true"></i>
                    </a>
                </div>
            }
        </div>
    }
</div>

<partial name="_Pagination" model="Model.ToPagination(new Dictionary<string, string>())" />

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.2/anime.min.js"></script>
    <script>
        (function () {
            // Purely cosmetic entrance animation. The page is fully visible if anything here fails.
            function restoreAll() {
                document.querySelectorAll('.his-anim, .his-table tbody tr, .his-item').forEach(function (el) {
                    el.style.opacity = '';
                    el.style.transform = '';
                });
            }

            try {
                var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                if (typeof anime === 'undefined' || reduce) { return; }

                var tl = anime.timeline({ easing: 'easeOutExpo' });

                tl.add({
                    targets: '.his-banner',
                    opacity: [0, 1], translateY: [-24, 0], duration: 700
                })
                .add({
                    targets: '.his-card',
                    opacity: [0, 1], translateY: [20, 0], duration: 600
                }, '-=400')
                .add({
                    targets: '.his-table tbody tr, .his-item',
                    opacity: [0, 1], translateY: [16, 0],
                    delay: anime.stagger(50), duration: 500
                }, '-=300');

                // Rate bars grow from zero
                document.querySelectorAll('.rate-fill').forEach(function (bar) {
                    var target = bar.style.width;
                    bar.style.width = '0%';
                    anime({
                        targets: bar, width: target,
                        duration: 900, delay: 600, easing: 'easeOutQuad'
                    });
                });

                tl.finished.then(restoreAll);
                setTimeout(restoreAll, 3000);
            } catch (err) {
                restoreAll();
            }
        })();
    </script>
}