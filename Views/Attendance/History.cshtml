@model PagedResult<HistoryRow>
@{
    ViewData["Title"] = "History";
}

<div class="page-header"><h1 class="h3 mb-1">Attendance history</h1></div>

<div class="card">
    @if (Model.TotalCount == 0)
    {
        <div class="card-body text-center text-muted py-5">No attendance taken yet.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr><th>Date</th><th>Subject</th><th>Teacher</th><th>Present</th><th>Absent</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Items)
                    {
                        <tr>
                            <td>@r.Date.ToString("dd MMM yyyy")</td>
                            <td>@r.Subject</td>
                            <td>@r.Teacher</td>
                            <td class="text-success fw-semibold">@r.Present</td>
                            <td class="text-danger fw-semibold">@r.Absent</td>
                            <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Result" asp-route-id="@r.Id">Open</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<partial name="_Pagination" model="Model.ToPagination(new Dictionary<string, string>())" />