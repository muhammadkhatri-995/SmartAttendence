@model StudentEditViewModel
@{
    ViewData["Title"] = "Edit student";
}

<div class="page-header"><h1 class="h3 mb-1">Edit student</h1></div>

<div class="card form-card">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="js-loading-form" novalidate>
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <div class="mb-3">
                <label asp-for="RollNumber" class="form-label"></label>
                <input asp-for="RollNumber" class="form-control" maxlength="30" />
                <span asp-validation-for="RollNumber" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="FullName" class="form-label"></label>
                <input asp-for="FullName" class="form-control" maxlength="150" />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}