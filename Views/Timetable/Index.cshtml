@model TimetableIndexViewModel
@{
    ViewData["Title"] = "Timetable";
    var days = new[] { DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday,
                       DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday };
}

<div class="page-header">
    <h1 class="h3 mb-1">Weekly timetable</h1>
    <p class="text-muted mb-0">@Model.Class.ClassName - @Model.Class.Section (@Model.Class.AcademicYear)</p>
</div>

@if (Model.Subjects.Count == 0 || Model.Teachers.Count == 0)
{
    <div class="alert alert-warning" role="alert">
        Add at least one <a asp-controller="Subjects" asp-action="Index">subject</a> and one
        <a asp-controller="Teachers" asp-action="Index">teacher</a> first.
    </div>
}
else
{
    <div class="card mb-3">
        <div class="card-header fw-semibold">Add lecture</div>
        <div class="card-body">
            <form asp-action="Add" method="post" class="row g-2 align-items-end js-loading-form">
                <div class="col-md-2">
                    <label for="day" class="form-label mb-1">Day</label>
                    <select id="day" name="day" class="form-select">
                        @foreach (var d in days)
                        {
                            <option value="@((int)d)">@d</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label for="startTime" class="form-label mb-1">Start time</label>
                    <input id="startTime" name="startTime" type="time" class="form-control" required />
                </div>
                <div class="col-md-3">
                    <label for="subjectId" class="form-label mb-1">Subject</label>
                    <select id="subjectId" name="subjectId" class="form-select" asp-items="Model.Subjects"></select>
                </div>
                <div class="col-md-3">
                    <label for="teacherId" class="form-label mb-1">Teacher</label>
                    <select id="teacherId" name="teacherId" class="form-select" asp-items="Model.Teachers"></select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Add</button>
                </div>
            </form>
        </div>
    </div>
}

@if (Model.Rows.Count == 0)
{
    <div class="card"><div class="card-body text-center text-muted py-4">No lectures in the timetable yet.</div></div>
}
else
{
    <div class="row g-3">
        @foreach (var d in days)
        {
            var rows = Model.Rows.Where(r => r.Day == d).ToList();
            if (rows.Count == 0) { continue; }
            <div class="col-md-6 col-xl-4">
                <div class="card h-100">
                    <div class="card-header fw-semibold">@d</div>
                    <ul class="list-group list-group-flush">
                        @foreach (var r in rows)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-semibold">@r.Start.ToString("hh:mm tt") &middot; @r.SubjectName</div>
                                    <div class="text-muted small">@r.TeacherName</div>
                                </div>
                                <form asp-action="Delete" asp-route-id="@r.Id" method="post"
                                      data-confirm="Remove @r.SubjectName at @r.Start.ToString("hh:mm tt") on @d?">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" aria-label="Remove lecture"><i class="bi bi-trash" aria-hidden="true"></i></button>
                                </form>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }
    </div>
}