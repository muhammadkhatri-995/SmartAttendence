@model TeacherDashboardViewModel
@{
    ViewData["Title"] = "My dashboard";
}

<div class="page-header">
    <h1 class="h3 mb-1">Welcome, @User.GetFullName()</h1>
    <p class="text-muted mb-0">@User.GetRoleLabel() &middot; @Model.Today.ToString("dddd, dd MMMM yyyy")</p>
</div>

<div class="card">
    <div class="card-header fw-semibold">My assigned classes and subjects</div>

    @if (Model.Assignments.Count == 0)
    {
        <div class="card-body text-center text-muted py-5">
            <i class="bi bi-inbox display-4" aria-hidden="true"></i>
            <p class="mt-3 mb-0">
                @(Model.HasTeacherProfile
                    ? "No active classes or subjects are assigned to you yet."
                    : "No teacher profile or assignments are linked to your account yet.")
                Please contact the administrator.
            </p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Class</th>
                        <th scope="col">Section</th>
                        <th scope="col">Subject</th>
                        <th scope="col">Academic year</th>
                        <th scope="col">Today</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.Assignments)
                    {
                        <tr>
                            <td>@a.ClassName</td>
                            <td>@a.Section</td>
                            <td>
                                @a.SubjectName <span class="text-muted small">(@a.SubjectCode)</span>
                                @if (a.IsDelegated)
                                {
                                    <span class="badge text-bg-light border ms-1">Delegated</span>
                                }
                            </td>
                            <td>@a.AcademicYear</td>
                            <td>
                                @@switch (a.TodayStatus)
                                {
                                    case AttendanceStatus.Submitted:
                                        <span class="badge text-bg-success">Submitted</span>
                                        break;
                                    case AttendanceStatus.Draft:
                                        <span class="badge text-bg-warning">Draft</span>
                                        break;
                                    default:
                                        <span class="badge text-bg-secondary">Not taken</span>
                                        break;
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>