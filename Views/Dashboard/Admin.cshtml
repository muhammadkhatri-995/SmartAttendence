@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin dashboard";

    var stats = new (string Label, int Value, string Icon, string Color)[]
    {
        ("Active teachers",    Model.ActiveTeachers,    "bi-person-badge",    "primary"),
        ("Active subjects",    Model.ActiveSubjects,    "bi-journal-text",    "success"),
        ("Active classes",     Model.ActiveClasses,     "bi-building",        "info"),
        ("Active students",    Model.ActiveStudents,    "bi-people",          "warning"),
        ("Active assignments", Model.ActiveAssignments, "bi-diagram-3",       "secondary")
    };
}

<div class="page-header">
    <h1 class="h3 mb-1">Admin dashboard</h1>
    <p class="text-muted mb-0">@Model.InstitutionName &middot; @Model.Today.ToString("dddd, dd MMMM yyyy")</p>
</div>

<div class="row g-3 mb-4">
    @foreach (var s in stats)
    {
        <div class="col-6 col-lg-4 col-xl">
            <div class="card stat-card h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="@($"stat-icon bg-{s.Color}-subtle text-{s.Color}")">
                        <i class="@($"bi {s.Icon}")" aria-hidden="true"></i>
                    </div>
                    <div>
                        <div class="stat-value">@s.Value.ToString("N0")</div>
                        <div class="text-muted small">@s.Label</div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header fw-semibold">Attendance today</div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    Submitted sessions
                    <span class="badge text-bg-success rounded-pill">@Model.SubmittedToday</span>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    Drafts not yet submitted
                    <span class="badge text-bg-warning rounded-pill">@Model.DraftsToday</span>
                </li>
            </ul>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header fw-semibold">Notifications</div>
            <div class="card-body">
                @if (Model.FailedNotifications > 0)
                {
                    <div class="alert alert-warning mb-0" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>
                        <strong>@Model.FailedNotifications</strong> failed WhatsApp notification(s) need attention.
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0">
                        <i class="bi bi-check-circle text-success me-1" aria-hidden="true"></i>
                        No failed notifications.
                    </p>
                }
            </div>
        </div>
    </div>
</div>