@model PaginationModel
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();

    Dictionary<string, string> Route(int p)
    {
        var d = new Dictionary<string, string>(Model.RouteValues) { ["page"] = p.ToString() };
        return d;
    }

    var start = Math.Max(1, Model.Page - 2);
    var end = Math.Min(Model.TotalPages, Model.Page + 2);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">
    <div class="text-muted small">
        Showing @Model.FirstItem&ndash;@Model.LastItem of @Model.TotalCount
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Pagination">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                    <a class="page-link" asp-controller="@controller" asp-action="@action"
                       asp-all-route-data="@Route(Model.Page - 1)" aria-label="Previous page">&laquo;</a>
                </li>

                @for (var p = start; p <= end; p++)
                {
                    <li class="page-item @(p == Model.Page ? "active" : "")">
                        <a class="page-link" asp-controller="@controller" asp-action="@action"
                           asp-all-route-data="@Route(p)"
                           aria-current="@(p == Model.Page ? "page" : null)">@p</a>
                    </li>
                }

                <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-controller="@controller" asp-action="@action"
                       asp-all-route-data="@Route(Model.Page + 1)" aria-label="Next page">&raquo;</a>
                </li>
            </ul>
        </nav>
    }
</div>