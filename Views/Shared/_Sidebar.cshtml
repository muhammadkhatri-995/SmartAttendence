<script>
    (function () {
        var nav = document.getElementById('appSidebar');
        var handle = document.getElementById('sbHandle');
        var backdrop = document.getElementById('sbBackdrop');
        if (!nav || !handle || !backdrop) return;

        var WIDTH = 250;
        var KEY = 'sidebarOpen';
        var root = document.documentElement;
        var mq = window.matchMedia('(min-width: 992px)');

        // 1. Find the layout column that used to hold the sidebar.
        var panel = null;
        var node = nav;
        while (node.parentElement && node.parentElement !== document.body) {
            var p = node.parentElement;
            var cs = getComputedStyle(p);
            var isRow = (cs.display === 'flex' && cs.flexDirection.indexOf('row') === 0) || cs.display === 'grid';
            if (isRow) { panel = node; break; }
            node = p;
        }

        var shell = panel ? panel.parentElement : document.querySelector('main');
        if (shell) {
            shell.classList.add('app-shell', 'sb-no-anim');
            if (panel) shell.classList.add('app-shell-split');
        }

        // 2. Move the sidebar out of the layout column, then hide that empty column.
        document.body.appendChild(backdrop);
        document.body.appendChild(handle);
        document.body.appendChild(nav);
        if (panel && panel !== nav) panel.style.display = 'none';

        // 3. Sidebar starts right under the top navbar.
        function placeUnderNavbar() {
            var bar = document.querySelector('.navbar');
            var top = bar ? Math.round(bar.getBoundingClientRect().bottom) : 56;
            if (top < 0) top = 0;
            root.style.setProperty('--sb-top', top + 'px');
        }
        placeUnderNavbar();
        window.addEventListener('resize', placeUnderNavbar);

        // 4. Open / close.
        function isDesktop() { return mq.matches; }

        function savedOpen() {
            var v = null;
            try { v = localStorage.getItem(KEY); } catch (e) { }
            return v !== '0';
        }

        var open = isDesktop() ? savedOpen() : false;

        function render() {
            nav.classList.toggle('open', open);
            handle.classList.toggle('open', open);
            handle.setAttribute('aria-expanded', String(open));
            handle.firstElementChild.className = open ? 'bi bi-chevron-left' : 'bi bi-chevron-right';
            root.style.setProperty('--sb-push', open && isDesktop() ? WIDTH + 'px' : '0px');
            backdrop.classList.toggle('show', open && !isDesktop());
        }

        function toggle() {
            open = !open;
            if (isDesktop()) { try { localStorage.setItem(KEY, open ? '1' : '0'); } catch (e) { } }
            render();
        }

        render();

        // No slide animation on first paint, only on later clicks.
        requestAnimationFrame(function () {
            requestAnimationFrame(function () {
                nav.classList.remove('sb-no-anim');
                handle.classList.remove('sb-no-anim');
                if (shell) shell.classList.remove('sb-no-anim');
            });
        });

        handle.addEventListener('click', toggle);
        backdrop.addEventListener('click', function () { open = false; render(); });

        // On phones, tapping a link closes the drawer.
        nav.addEventListener('click', function (e) {
            if (!isDesktop() && e.target.closest('a')) { open = false; render(); }
        });

        mq.addEventListener('change', function () {
            open = isDesktop() ? savedOpen() : false;
            render();
        });

        document.addEventListener('keydown', function (e) {
            var t = e.target;
            var typing = t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.tagName === 'SELECT' || t.isContentEditable);
            if (typing || e.ctrlKey || e.metaKey || e.altKey) return;
            if (e.key === '[') toggle();
            if (e.key === 'Escape' && !isDesktop() && open) { open = false; render(); }
        });

        // 5. Live date and time.
        var dateEl = document.getElementById('sbDate');
        var clockEl = document.getElementById('sbClock');
        function tick() {
            var n = new Date();
            if (dateEl) dateEl.textContent = n.toLocaleDateString(undefined, { weekday: 'long', day: 'numeric', month: 'short' });
            if (clockEl) clockEl.textContent = n.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
